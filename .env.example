# Canva Connect integration (optional).
# Create an integration at https://www.canva.com/developers/ (Developer Portal),
# generate a client secret, select scopes
# (asset:read asset:write design:content:write design:meta:read), and add a
# redirect URL that matches CANVA_REDIRECT_URI below.
#
# When these are unset, the app runs normally and the "Send to Canva" feature
# is simply hidden.

CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
# Must exactly match a redirect URL registered on your Canva integration, e.g.
#   https://<project>.vercel.app/api/canva/callback
# For local development (if allowed by your integration):
#   http://127.0.0.1:3000/api/canva/callback
CANVA_REDIRECT_URI=
